POSTGRES_USER=scheduler
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=distributed_scheduler

RABBITMQ_DEFAULT_USER=scheduler
RABBITMQ_DEFAULT_PASS=your_strong_password_here

JWT_SECRET=your_long_random_secret_here_min_32_chars

DATABASE_URL=postgresql://scheduler:your_strong_password_here@postgres:5432/distributed_scheduler
RABBITMQ_URL=amqp://scheduler:your_strong_password_here@rabbitmq:5672

# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_strong_grafana_password_here

# Worker retries before DLQ (default 3)
TASK_MAX_RETRIES=3

# Coordinator reconciliation interval in seconds (default 120)
SCHEDULER_RECONCILE_INTERVAL_SEC=120
