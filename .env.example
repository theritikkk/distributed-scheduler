POSTGRES_USER=scheduler
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=distributed_scheduler

RABBITMQ_DEFAULT_USER=scheduler
RABBITMQ_DEFAULT_PASS=your_password_here

JWT_SECRET=your_secret_here

DATABASE_URL=postgresql://scheduler:your_password_here@postgres:5432/distributed_scheduler
RABBITMQ_URL=amqp://scheduler:your_password_here@rabbitmq:5672

# Worker retries before DLQ (default 3)
TASK_MAX_RETRIES=3

# Coordinator reconciliation interval seconds (default 120)
SCHEDULER_RECONCILE_INTERVAL_SEC=120