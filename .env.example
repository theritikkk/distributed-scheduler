POSTGRES_USER=scheduler
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=distributed_scheduler

RABBITMQ_DEFAULT_USER=scheduler
RABBITMQ_DEFAULT_PASS=your_strong_password_here

# Generate with: openssl rand -hex 32
# Production startup rejects missing, short, or documented placeholder values.
JWT_SECRET=your_long_random_secret_here_min_32_chars

DATABASE_URL=postgresql://scheduler:your_strong_password_here@postgres:5432/distributed_scheduler
RABBITMQ_URL=amqp://scheduler:your_strong_password_here@rabbitmq:5672

# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_strong_grafana_password_here

# Worker retries before DLQ (default 3)
TASK_MAX_RETRIES=3

# Coordinator reconciliation interval in seconds (default 120)
SCHEDULER_RECONCILE_INTERVAL_SEC=120

# Reconciliation poll jitter as a fraction of the interval (0.0-0.5)
RECONCILE_INTERVAL_JITTER_RATIO=0.2

# Scheduling jitter. Disabled by default; enable before opting tasks in.
# DEFAULT_RECURRING_JITTER_SEC=0 preserves exact cron semantics.
SCHEDULER_JITTER_ENABLED=false
DEFAULT_RECURRING_JITTER_SEC=0
MAX_JITTER_SEC=300

# Worker retry backoff jitter: full, equal, or none (default full)
RETRY_JITTER_MODE=full

# Durable API idempotency for POST /tasks (Idempotency-Key)
IDEMPOTENCY_ENFORCE=true

# Transactional outbox. Set false only for a deliberate rollback to direct
# publisher-confirm delivery; all API/coordinator/worker services must agree.
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_SEC=1
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_SEC=1
OUTBOX_BACKOFF_MAX_SEC=60
OUTBOX_MAX_PUBLISH_PER_SEC=100
OUTBOX_RETENTION_DAYS=7
OUTBOX_CLEANUP_INTERVAL_SEC=3600

# Phase 6 DB-backed timers. The outbox relay materializes task.scheduled /
# task.retry events into scheduled_events; a poller publishes them when due.
# This removes per-message TTL from the critical path and is required for
# quorum queues.
SCHEDULED_EVENTS_ENABLED=true
SCHEDULED_EVENT_POLL_INTERVAL_SEC=1.0
SCHEDULED_EVENT_BATCH_SIZE=100
SCHEDULED_EVENT_MAX_ATTEMPTS=10
SCHEDULED_EVENT_BACKOFF_BASE_SEC=1
SCHEDULED_EVENT_BACKOFF_MAX_SEC=60
SCHEDULED_EVENT_RETENTION_DAYS=7
SCHEDULED_EVENT_CLEANUP_INTERVAL_SEC=3600
SCHEDULED_EVENT_MAX_PUBLISH_PER_SEC=100

# Queue HA mode. Keep classic for local development. Set quorum only after
# draining/deleting the old scheduler.delay and scheduler.retry_delay queues;
# quorum mode requires OUTBOX_ENABLED=true and SCHEDULED_EVENTS_ENABLED=true.
# All API/coordinator/worker replicas must use the same value.
RABBITMQ_QUEUE_TYPE=classic

# Execution lease reaper and stale-dispatch recovery
REAPER_ENABLED=true
REAPER_INTERVAL_SEC=15
PENDING_RETRY_GRACE_SEC=300
IDEMPOTENCY_CLEANUP_INTERVAL_SEC=3600

# Worker execution lease: heartbeat must be shorter than the lease
EXECUTION_LEASE_SEC=60
LEASE_HEARTBEAT_SEC=20

# Optional coordinator metric identity (defaults to hostname:pid)
COORDINATOR_ID=

# Runtime environment. Production requires explicit DATABASE_URL, RABBITMQ_URL,
# and a non-default JWT_SECRET of at least 32 characters.
APP_ENV=production
NODE_ENV=production

# API gateway
PORT=3000
CORS_ORIGIN=*
TRUST_PROXY=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
# Layered rate limiting. Start in observe mode, then switch to enforce.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MODE=observe
REDIS_URL=redis://redis:6379/0
# Optional Redis Cluster seed list. When set, it takes precedence over
# REDIS_URL. The Lua token bucket uses one key per call, so no hash tags are
# needed. Use the cluster's client endpoint, not a Sentinel proxy.
# REDIS_CLUSTER_NODES=redis-1:6379,redis-2:6379,redis-3:6379
RATE_LIMIT_REDIS_TIMEOUT_MS=50
RATE_LIMIT_FAILURE_THRESHOLD=5
RATE_LIMIT_FAILURE_WINDOW_MS=10000
RATE_LIMIT_OPEN_MS=30000
LOCAL_FALLBACK_RPS=20
GLOBAL_INGRESS_RPS=2000
GLOBAL_INGRESS_BURST=4000
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_LOGIN_BURST=2
RATE_LIMIT_USER_TASKS_PER_MIN=60
RATE_LIMIT_USER_TASKS_BURST=10
ADMISSION_ENABLED=false
DB_POOL_HIGH_WATERMARK=0.80
DB_POOL_MAX_WAITERS=5
QUEUE_BACKLOG_HIGH=5000
QUEUE_BACKLOG_LOW=1000
LOG_REQUESTS=true

# Coordinator backpressure. Keep observe for the first rollout; enforce is the
# one-flag rollback target if pause behavior is too aggressive.
BACKPRESSURE_MODE=observe
BACKPRESSURE_TASKS_HIGH=5000
BACKPRESSURE_TASKS_LOW=1000
BACKPRESSURE_RESULTS_HIGH=2000
BACKPRESSURE_RESULTS_LOW=500
BACKPRESSURE_DUE_HIGH=10000
BACKPRESSURE_POLL_SEC=1.0
BACKPRESSURE_HIGH_CONSECUTIVE=2
BACKPRESSURE_LOW_CONSECUTIVE=3
BACKPRESSURE_STALE_PAUSE_SEC=15
DISPATCH_RATE_PER_SEC=200
DISPATCH_BURST=20
# DB_POOL_MAX / DB_POOL_MAX_WAITERS / DB_POOL_HIGH_WATERMARK are shared with
# the API admission section above.
DB_POOL_RESUME_WATERMARK=0.60
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
RECONCILE_BATCH=100
RECONCILE_PACE_SEC=0.01

# Coordinator and worker
DB_CONNECT_TIMEOUT_SEC=5
RABBITMQ_METRICS_POLL_SEC=15
COMMAND_TIMEOUT_SEC=300
MAX_OUTPUT_BYTES=1048576
WORKER_CONCURRENCY=1
HEARTBEAT_INTERVAL_SEC=20

# --- Phase 7: optional Redis cache, tenant quotas, tracing, archival ---
# Redis remains an accelerator. Task state, execution slots, leases,
# idempotency keys, the outbox, and timers stay authoritative in PostgreSQL.
# Every feature below is default-off and fails open to PostgreSQL.

# Task / execution-history read cache. Short TTL; explicit invalidation on
# task update/delete and a generation counter for execution pages.
CACHE_ENABLED=false
CACHE_TTL_SEC=15
CACHE_REDIS_TIMEOUT_MS=50

# Completed idempotent-response cache. PostgreSQL remains authoritative.
IDEMPOTENCY_CACHE_ENABLED=false
IDEMPOTENCY_CACHE_TTL_SEC=900

# Weighted per-tenant admission quotas. Effective rate/burst =
# tenant_quotas.tasks_per_min/burst * weight. Disabled or missing rows use
# the defaults below, not unlimited access. RATE_LIMIT_MODE still controls
# observe vs enforce for quota denials.
TENANT_QUOTAS_ENABLED=false
TENANT_QUOTA_CACHE_TTL_SEC=30
TENANT_DEFAULT_WEIGHT=1
TENANT_DEFAULT_TASKS_PER_MIN=60
TENANT_DEFAULT_BURST=10

# Global ingress limiter is spread across this many Redis keys. Use 1 to
# disable sharding; 16 is the default for multi-replica API deployments.
GLOBAL_INGRESS_SHARDS=16

# OpenTelemetry W3C tracing. OTEL_SERVICE_NAME defaults to the service name
# (api-gateway, coordinator, worker). Install the optional Python packages in
# requirements.txt before enabling tracing for the coordinator/worker.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SAMPLER_ARG=0.1

# Coordinator-only bounded archival of terminal history. Pending/running
# executions, pending outbox rows, and pending timers are never archived.
# Archive rules only move terminal rows older than the retention window.
ARCHIVE_ENABLED=false
ARCHIVE_RETENTION_DAYS=30
ARCHIVE_BATCH_SIZE=500
ARCHIVE_INTERVAL_SEC=3600
ARCHIVE_MAX_BATCHES=20
ARCHIVE_SLEEP_MS=50
