{
  "title": "Distributed Scheduler v2",
  "uid": "distributed-scheduler-v2",
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 2,
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
