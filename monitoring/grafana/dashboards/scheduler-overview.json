{
  "title": "Distributed Scheduler v2",
  "uid": "distributed-scheduler-v2",
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 2,
  "refresh": "30s",
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "panels": [

    {
      "type": "row",
      "id": 100,
      "title": "System Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 1,
      "type": "stat",
      "title": "Active Workers",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "sum(scheduler_worker_consumer_up)",
        "refId": "A"
      }],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          }
        }
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Queue Depth (scheduler.tasks)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "max(scheduler_rabbitmq_queue_messages{queue=\"scheduler.tasks\"})",
        "refId": "A"
      }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 10   },
              { "color": "red",    "value": 50   }
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "DLQ Depth",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "max(scheduler_rabbitmq_queue_messages{queue=\"scheduler.tasks.dlq\"})",
        "refId": "A"
      }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1    }
            ]
          }
        }
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "RabbitMQ Connections",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rabbitmq_connections",
        "refId": "A"
      }],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          }
        }
      }
    },

    {
      "id": 5,
      "type": "gauge",
      "title": "Worker Success Rate",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 5 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "100 * sum(rate(scheduler_worker_tasks_completed_total[5m])) / sum(rate(scheduler_worker_tasks_started_total[5m]))",
        "refId": "A"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "minVizWidth": 75,
        "minVizHeight": 75
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 80   },
              { "color": "green",  "value": 95   }
            ]
          }
        }
      }
    },

    {
      "id": 6,
      "type": "bargauge",
      "title": "Worker Utilization (completions/s per worker)",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 5 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "sum by(worker_id) (rate(scheduler_worker_tasks_completed_total[5m]))",
        "legendFormat": "{{worker_id}}",
        "refId": "A"
      }],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      }
    },

    {
      "type": "row",
      "id": 101,
      "title": "Task Processing",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 }
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Task Throughput (acks/s)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "sum(rate(scheduler_worker_tasks_acked_total[1m]))",
        "legendFormat": "Tasks/sec",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Task Lifecycle (started vs completed)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(scheduler_worker_tasks_started_total[1m]))",
          "legendFormat": "Started",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(scheduler_worker_tasks_completed_total[1m]))",
          "legendFormat": "Completed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    {
      "id": 9,
      "type": "timeseries",
      "title": "Coordinator Results Applied",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rate(scheduler_coordinator_results_applied_total[1m])",
        "legendFormat": "Results Applied",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },

    {
      "type": "row",
      "id": 102,
      "title": "Latency & Scheduling",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Task Latency p95",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 21 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "histogram_quantile(0.95, sum(rate(scheduler_worker_task_duration_seconds_bucket[5m])) by (le))",
        "legendFormat": "p95",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "Due Tasks Dispatched",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 21 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rate(scheduler_coordinator_due_dispatched_total[1m])",
        "legendFormat": "Dispatch Rate",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Reconciliation Nudges",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 21 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rate(scheduler_coordinator_reconciliation_nudged_total[1m])",
        "legendFormat": "Reconciliation",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },

    {
      "type": "row",
      "id": 103,
      "title": "RabbitMQ",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 }
    },

    {
      "id": 13,
      "type": "timeseries",
      "title": "All Queue Sizes",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 30 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "scheduler_rabbitmq_queue_messages",
        "legendFormat": "{{queue}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    {
      "id": 14,
      "type": "stat",
      "title": "Workers Marked Offline (last 1h)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 30 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "increase(scheduler_coordinator_workers_marked_offline_total[1h])",
        "refId": "A"
      }],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "red",    "value": 3    }
            ]
          }
        }
      }
    }

  ]
}
